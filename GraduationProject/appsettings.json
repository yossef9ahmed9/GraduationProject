    "SmtpPort": 587,
    "SenderEmail": "YOUR_EMAIL_HERE",
    "SenderName": "Graduation Project",
    "Password": "YOUR_EMAIL_PASSWORD_HERE"
  },
  "HeartRiskApi": {
    "BaseUrl": "http://127.0.0.1:8000"
  },
  "Firebase": {
    "CredentialPath": "firebase-adminsdk.json"
  }
}
